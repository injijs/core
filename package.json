{
  "name": "@injijs/core",
  "version": "0.1.2",
  "description": "Zero-dependency TypeScript library for ESC/P 24-J84 dot-matrix impact printers.",
  "keywords": [
    "24-j84",
    "dot-matrix",
    "epson",
    "esc-p",
    "escp",
    "jis",
    "printer"
  ],
  "homepage": "https://github.com/injijs/core#readme",
  "bugs": {
    "url": "https://github.com/injijs/core/issues"
  },
  "license": "MIT",
  "author": "s-nishiura (https://github.com/s-nishiura)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/injijs/core.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./transports": "./dist/transports/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "release": "bumpp",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.5",
    "bumpp": "^12.3.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  }
}
